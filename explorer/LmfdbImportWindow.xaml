<Window x:Class="EllipticCurves.Explorer.LmfdbImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Import curve from LMFDB" Width="760" Height="680" MinWidth="640" MinHeight="560"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13" ShowInTaskbar="False" WindowStartupLocation="CenterOwner" UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False" /></shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="ImportError" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="1">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,0">
            <Grid><TextBlock Text="EXPLORER · LMFDB" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" />
                <Button Click="CloseClick" Style="{StaticResource QuietButton}" Width="40" Padding="0" HorizontalAlignment="Right" Margin="0,0,-12,0" shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Close import window">
                    <Path Style="{StaticResource CaptionCloseIcon}" />
                </Button>
            </Grid>
        </Border>
        <StackPanel Grid.Row="1" Margin="24,20,24,12">
            <TextBlock Text="Import curve from LMFDB" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="Find a curve over ℚ by conductor and import its equation." Style="{StaticResource Muted}" Margin="0,8,0,16" TextWrapping="Wrap" LineHeight="18" />
            <TextBlock Text="Conductor N" FontWeight="SemiBold" Margin="0,0,0,7" />
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBox x:Name="ConductorInput" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" MaxLength="40" MinHeight="36" VerticalContentAlignment="Center" AutomationProperties.Name="Conductor or conductor range" />
                <Button x:Name="SearchButton" Grid.Column="1" Content="Search" Click="SearchClick" IsEnabled="{Binding CanSearch}" IsDefault="True" Margin="10,0,0,0" Padding="20,6" />
                <Button Grid.Column="2" Content="Stop" Click="StopClick" Visibility="{Binding IsBusy, Converter={StaticResource BooleanVisibility}}" Margin="8,0,0,0" Padding="14,6" />
            </Grid>
            <TextBlock Text="Examples: 37 or 11-100 · up to 500000. Complete catalog for N &lt; 500000." Style="{StaticResource Muted}" FontSize="11" Margin="0,7,0,0" TextWrapping="Wrap" />
            <TextBlock Text="{Binding InputError}" Style="{StaticResource ImportError}" />
        </StackPanel>
        <Grid Grid.Row="2" Margin="24,0,24,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                <TextBlock Text="{Binding Error}" Style="{StaticResource ImportError}" />
            </StackPanel>
            <ProgressBar Grid.Row="1" Height="3" IsIndeterminate="True" Margin="0,8,0,0" Foreground="{StaticResource AccentBrush}" Background="{StaticResource BorderBrush}" BorderThickness="0" Visibility="{Binding IsBusy, Converter={StaticResource BooleanVisibility}}" AutomationProperties.Name="Loading LMFDB formulas" />
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="4" Margin="0,10,0,10">
                <ListBox x:Name="CurveList" ItemsSource="{Binding Curves}" SelectedItem="{Binding Selected}" Style="{StaticResource WorkbenchList}" AutomationProperties.Name="LMFDB curves"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False">
                    <ListBox.ItemTemplate><DataTemplate>
                        <StackPanel Margin="5,2">
                            <TextBlock Text="{Binding Label}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Equation}" FontFamily="Consolas" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Equation}" />
                        </StackPanel>
                    </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
            </Border>
            <Grid Grid.Row="3">
                <TextBlock Text="{Binding PageInfo}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="← Previous" Click="PreviousClick" IsEnabled="{Binding CanPrevious}" Padding="12,5" Margin="0,0,8,0" />
                    <Button Content="Next →" Click="NextClick" IsEnabled="{Binding CanNext}" Padding="12,5" />
                </StackPanel>
            </Grid>
        </Grid>
        <StackPanel Grid.Row="3" Margin="24,14,24,16">
            <TextBlock Text="SELECTED EQUATION" Style="{StaticResource Eyebrow}" FontSize="9" Margin="0,0,0,7" />
            <TextBox Text="{Binding Selected.Equation, Mode=OneWay}" MinHeight="36" MaxHeight="90" Padding="10,8,20,8" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Style="{StaticResource ReportText}" FontFamily="Consolas"
                     FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" AutomationProperties.Name="Selected curve equation" />
        </StackPanel>
        <Border Grid.Row="4" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="Only the equation is imported." Style="{StaticResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0" />
                <Button x:Name="ImportButton" Grid.Column="1" Content="Import formula  →" Click="ImportClick" IsEnabled="{Binding CanImport}" Foreground="{StaticResource AccentBrush}" />
            </Grid>
        </Border>
    </Grid>
</Window>
