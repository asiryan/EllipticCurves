<Window x:Class="EllipticCurves.Explorer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:EllipticCurves.Explorer.Controls"
        xmlns:local="clr-namespace:EllipticCurves.Explorer"
        Title="{x:Static local:ExplorerInfo.WindowTitle}" Width="1440" Height="920" MinWidth="1120" MinHeight="760"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI" FontSize="13"
        Icon="ec_logo.png" UseLayoutRounding="True" Loaded="WindowLoaded" Closed="WindowClosed">
    <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" /></shell:WindowChrome.WindowChrome>
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{x:Static ApplicationCommands.New}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{x:Static ApplicationCommands.Open}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{x:Static ApplicationCommands.Save}" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{x:Static ApplicationCommands.SaveAs}" />
        <KeyBinding Key="F" Modifiers="Control" Command="{Binding FitCommand}" />
        <KeyBinding Key="Z" Modifiers="Control" Command="{x:Static ApplicationCommands.Undo}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{x:Static ApplicationCommands.Redo}" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static ApplicationCommands.Undo}" PreviewExecuted="EditCommandExecuted" PreviewCanExecute="EditCommandCanExecute" CanExecute="EditCommandCanExecute" />
        <CommandBinding Command="{x:Static ApplicationCommands.Redo}" PreviewExecuted="EditCommandExecuted" PreviewCanExecute="EditCommandCanExecute" CanExecute="EditCommandCanExecute" />
        <CommandBinding Command="{x:Static ApplicationCommands.New}" Executed="SessionCommandExecuted" CanExecute="SessionCommandCanExecute" />
        <CommandBinding Command="{x:Static ApplicationCommands.Open}" Executed="SessionCommandExecuted" CanExecute="SessionCommandCanExecute" />
        <CommandBinding Command="{x:Static ApplicationCommands.Save}" Executed="SessionCommandExecuted" CanExecute="SessionCommandCanExecute" />
        <CommandBinding Command="{x:Static ApplicationCommands.SaveAs}" Executed="SessionCommandExecuted" CanExecute="SessionCommandCanExecute" />
    </Window.CommandBindings>
    <Window.Resources>
        <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
            <Setter Property="Width" Value="44" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style x:Key="PlotNavigationButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style x:Key="SidebarSplitter" TargetType="GridSplitter">
            <Setter Property="Width" Value="4" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{StaticResource BorderBrush}" />
            <Setter Property="Cursor" Value="SizeWE" />
            <Setter Property="ResizeDirection" Value="Columns" />
            <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
        </Style>
        <Style x:Key="SidebarTab" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource ButtonFocusVisual}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TabFrame" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabFrame" Property="Background" Value="{StaticResource RaisedBrush}" /><Setter TargetName="TabFrame" Property="BorderBrush" Value="{StaticResource AccentBrush}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid x:Name="AppRoot" Margin="1" Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions><RowDefinition Height="44" /><RowDefinition Height="*" /><RowDefinition Height="32" /></Grid.RowDefinitions>
        <Border BorderBrush="#242E38" BorderThickness="0,0,0,1" Padding="8,0,8,0">
            <Grid Grid.IsSharedSizeScope="True">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="TitleBarSide" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" SharedSizeGroup="TitleBarSide" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="0,8,0,0">
                    <Button Click="RepositoryClick" Style="{StaticResource QuietButton}" Padding="0" Cursor="Hand"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="{x:Static local:ExplorerInfo.RepositoryUrl}" AutomationProperties.Name="Open Elliptic Curves on GitHub">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="ec_logo.png" Width="28" Height="28" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Elliptic Curves logo" />
                            <TextBlock Text="ELLIPTIC CURVES" FontWeight="SemiBold" FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Border Width="1" Height="13" Background="{StaticResource BorderBrush}" Margin="18,0,8,0" />
                    <controls:SessionMenu x:Name="Session" FontSize="12" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                    <controls:EditMenu x:Name="Edit" FontSize="12" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                    <controls:ExplorerMenu x:Name="Explorer" FontSize="12" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                </StackPanel>
                <Grid x:Name="SessionFileIndicator" Grid.Column="1" MaxWidth="460" Margin="24,0" VerticalAlignment="Center" HorizontalAlignment="Center" ClipToBounds="True"
                      DataContext="{Binding SessionStatus, RelativeSource={RelativeSource AncestorType=Window}}"
                      ToolTip="{Binding FileLocation}" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border x:Name="SessionStatusBadge" Background="{StaticResource RaisedBrush}" CornerRadius="5" Padding="8,4" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="5" Height="5" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Ellipse.Style><Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NeedsSave}" Value="True"><Setter Property="Fill" Value="{StaticResource WarningBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding IsSaving}" Value="True"><Setter Property="Fill" Value="{StaticResource AccentBrush}" /></DataTrigger>
                                    </Style.Triggers>
                                </Style></Ellipse.Style>
                            </Ellipse>
                            <TextBlock x:Name="SessionSaveStatus" Text="{Binding Status}" FontSize="12" Foreground="{StaticResource MutedBrush}"
                                       AutomationProperties.Name="Session save status" AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="SessionFileName" Grid.Column="1" Text="{Binding DisplayName}" FontSize="12"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ClipToBounds="True"
                               AutomationProperties.Name="Session file name" />
                </Grid>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionButton}" Click="MinimizeClick" AutomationProperties.Name="Minimize">
                        <Path Style="{StaticResource CaptionIcon}" Data="M0,5.5 H10" />
                    </Button>
                    <Button Style="{StaticResource CaptionButton}" Click="MaximizeClick" AutomationProperties.Name="Maximize or restore">
                        <Path>
                            <Path.Style>
                                <Style TargetType="Path" BasedOn="{StaticResource CaptionIcon}">
                                    <Setter Property="Data" Value="M0.5,0.5 H9.5 V9.5 H0.5 Z" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="Maximized">
                                            <Setter Property="Data" Value="M0.5,2.5 H7.5 V9.5 H0.5 Z M2.5,2.5 V0.5 H9.5 V7.5 H7.5" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Button>
                    <Button Style="{StaticResource CaptionButton}" Click="CloseClick" AutomationProperties.Name="Close">
                        <Path Style="{StaticResource CaptionCloseIcon}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        <Grid x:Name="Workspace" Grid.Row="1" Margin="20,16,20,0" ClipToBounds="True">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="EquationColumn" Width="238" MinWidth="238" /><ColumnDefinition Width="12" /><ColumnDefinition x:Name="PlotColumn" Width="*" MinWidth="400" /><ColumnDefinition Width="12" /><ColumnDefinition x:Name="ResultsColumn" Width="300" MinWidth="300" /></Grid.ColumnDefinitions>
            <Grid x:Name="EquationHost" ClipToBounds="True">
            <Border x:Name="EquationPanel" Style="{StaticResource Card}">
                <ScrollViewer x:Name="EquationScroll" Style="{StaticResource PanelScrollViewer}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Button x:Name="EquationCollapseButton" Click="CollapseEquationClick" Style="{StaticResource QuietButton}" Width="24" Height="32" Padding="0,2" Margin="-6,0,6,0" ToolTip="Collapse equation panel" AutomationProperties.Name="Collapse equation panel">
                                <Path Style="{StaticResource DisclosureChevron}" Data="{StaticResource ChevronLeftGeometry}" />
                            </Button>
                            <TextBlock Grid.Column="1" Text="Equation" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Content="Reset" Click="ResetEquationClick" Style="{StaticResource QuietButton}" Padding="4,3" Foreground="{StaticResource MutedBrush}" />
                        </Grid>
                        <TextBlock Text="{Binding FormDescription}" Style="{StaticResource Muted}" Margin="0,12,0,0" TextWrapping="Wrap" />
                        <TextBlock x:Name="EquationIntro" Text="Enter a Weierstrass equation." Style="{StaticResource Muted}" Margin="0,18,0,0" TextWrapping="Wrap" LineHeight="18" ToolTip="Enter the whole curve equation above. Simple and general Weierstrass forms are recognized automatically." />
                        <TextBlock Text="y^2 = x^3 - 106.16x - 0.32" FontFamily="Consolas" Foreground="{StaticResource TextBrush}" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="y^2 + xy + y = x^3 - x" FontFamily="Consolas" Foreground="{StaticResource TextBrush}" FontSize="11" Margin="0,7,0,0" TextWrapping="Wrap" />
                        <StackPanel Margin="0,12,0,0">
                            <TextBlock Text="Powers: ^" Style="{StaticResource Muted}" LineHeight="18" />
                            <TextBlock Text="Multiply: * or omit" Style="{StaticResource Muted}" LineHeight="18" />
                            <TextBlock Text="Numbers: 8.325 · 8,325 · 2/7" Style="{StaticResource Muted}" LineHeight="18" ToolTip="Decimals, decimal commas, fractions and scientific notation are accepted." />
                        </StackPanel>
                        <Expander x:Name="CoefficientsExpander" Header="Coefficients" Foreground="{StaticResource TextBrush}" Margin="0,22,0,0" HorizontalContentAlignment="Stretch" Cursor="Hand">
                            <StackPanel Margin="0,12,0,0" Cursor="Arrow">
                                <TextBlock Text="SLIDER STEP" Style="{StaticResource Eyebrow}" Margin="0,0,0,9" />
                                <TextBox DataContext="{Binding Step}" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" MinHeight="34" AutomationProperties.Name="Slider step" LostKeyboardFocus="CoefficientEditFinished" PreviewKeyDown="CoefficientKeyDown" />
                                <UniformGrid Columns="3" Margin="0,7,0,12"><Button Content="1" Command="{Binding SetStepCommand}" CommandParameter="1" Padding="0,6" Margin="0,0,4,0" /><Button Content="0.1" Command="{Binding SetStepCommand}" CommandParameter="0.1" Padding="0,6" Margin="0,0,4,0" /><Button Content="0.01" Command="{Binding SetStepCommand}" CommandParameter="0.01" Padding="0,6" /></UniformGrid>
                                <TextBlock Text="Range: ±50 steps.&#10;Right-click to reset to 0." Style="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,12" ToolTip="Editing a coefficient in the equation or changing the step recenters its slider range." />
                                <ItemsControl ItemsSource="{Binding ActiveCoefficients}">
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <StackPanel Margin="0,0,0,15">
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontFamily="Cambria Math" FontSize="18" /><TextBlock Grid.Column="1" Text="{Binding Text}" FontFamily="Consolas" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text}" /></Grid>
                                            <Slider Value="{Binding SliderOffset, Mode=TwoWay}" Minimum="-50" Maximum="50" TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="5" Margin="0,-4,0,0" PreviewMouseRightButtonDown="ResetSlider" AutomationProperties.Name="{Binding Name, StringFormat=Coefficient {0}; right-click to reset to zero}">
                                                <Slider.Style><Style TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}"><Style.Triggers><DataTrigger Binding="{Binding IsValid}" Value="False"><Setter Property="Opacity" Value="0.4" /></DataTrigger></Style.Triggers></Style></Slider.Style>
                                            </Slider>
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="{Binding SliderMinimum}" FontSize="10" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SliderMinimum}" /><TextBlock Grid.Column="2" Text="{Binding SliderMaximum}" FontSize="10" Foreground="{StaticResource MutedBrush}" TextAlignment="Right" TextTrimming="CharacterEllipsis" ToolTip="{Binding SliderMaximum}" /></Grid>
                                        </StackPanel>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Expander>
                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,22,0,18" />
                        <TextBlock Text="START SOMEWHERE" Style="{StaticResource Eyebrow}" Margin="0,0,0,10" />
                        <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" DisplayMemberPath="Name" AutomationProperties.Name="Curve preset" />
                        <TextBlock Text="{Binding PresetDescription}" Style="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="Your zoom stays in place.&#10;Reset view recenters the view." Style="{StaticResource Muted}" Margin="0,18,0,0" TextWrapping="Wrap" LineHeight="18" ToolTip="The graph updates automatically after a short pause when you edit the equation." />
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <Button x:Name="EquationTab" Style="{StaticResource SidebarTab}" Visibility="Collapsed"
                    Click="ExpandEquationClick" ToolTip="Expand equation panel" AutomationProperties.Name="Expand equation panel">
                <StackPanel HorizontalAlignment="Center">
                    <Grid Height="24" Margin="0,0,0,10"><Path Style="{StaticResource DisclosureChevron}" Data="{StaticResource ChevronRightGeometry}" Stroke="{StaticResource AccentBrush}" /></Grid>
                    <TextBlock Text="EQUATION" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center">
                        <TextBlock.LayoutTransform><RotateTransform Angle="-90" /></TextBlock.LayoutTransform>
                    </TextBlock>
                </StackPanel>
            </Button>
            </Grid>
            <GridSplitter x:Name="EquationSplitter" Grid.Column="1" Style="{StaticResource SidebarSplitter}" ToolTip="Resize equation panel" AutomationProperties.Name="Resize equation panel" />
            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="*" /><RowDefinition Height="10" /><RowDefinition Height="80" /><RowDefinition Height="10" /><RowDefinition Height="60" /></Grid.RowDefinitions>
                <Border Style="{StaticResource Card}" Padding="20,10">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Text="EDIT YOUR EQUATION" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" />
                        <Button Content="Copy" Click="CopyClick" Style="{StaticResource QuietButton}" HorizontalAlignment="Right" Padding="8,2" Foreground="{StaticResource MutedBrush}" ToolTip="Copy the displayed curve and exact invariants" />
                        <StackPanel Grid.Row="1" Margin="0,8,0,6" DataContext="{Binding Equation}">
                            <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" MinHeight="40" FontSize="17" Padding="12,6" AutomationProperties.Name="Curve equation" LostKeyboardFocus="EquationEditFinished" PreviewKeyDown="EquationKeyDown" />
                            <TextBlock Text="{Binding Error}" Foreground="{StaticResource WarningBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0">
                                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Error}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Grid.Row="2" Style="{StaticResource Eyebrow}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Snapshot.Equation}">
                            <Run Text="EQUATION OVER ℚ : " /><Run Text="{Binding Snapshot.Equation, Mode=OneWay}" FontFamily="Cambria Math" FontSize="14" FontWeight="Normal" />
                        </TextBlock>
                    </Grid>
                </Border>
                <Border x:Name="PlotCard" Grid.Row="2" Style="{StaticResource Card}" Background="#121920" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid Margin="16,10" MinHeight="32">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <WrapPanel VerticalAlignment="Center">
                                <ComboBox x:Name="ViewMode" Width="190" Margin="0,0,16,0" SelectedIndex="0" SelectionChanged="ViewModeChanged"
                                          AutomationProperties.Name="Visualization mode" ToolTip="Choose the real curve or the complex period lattice and torus">
                                    <ComboBoxItem Content="Real locus · E(ℝ)" />
                                    <ComboBoxItem Content="Complex torus · E(ℂ)" />
                                </ComboBox>
                                <CheckBox Content="Grid" IsChecked="{Binding ShowGrid}" Height="28" VerticalContentAlignment="Center" Margin="0,0,16,0" />
                                <CheckBox Content="Rational samples" IsChecked="{Binding ShowPoints}" Height="28" VerticalContentAlignment="Center" />
                            </WrapPanel>
                            <Button x:Name="ExportPlotButton" Grid.Column="1" Content="Export plot" Click="ExportClick" Width="90" Height="30" Padding="10,6" FontSize="11" Margin="16,0,0,0" VerticalAlignment="Center" ToolTip="Save the current plot as a PNG image" />
                        </Grid>
                        <Grid x:Name="RealPlotHost" Grid.Row="1">
                            <controls:CurvePlot x:Name="Plot" Snapshot="{Binding Snapshot}" Samples="{Binding Samples}" ShowGrid="{Binding ShowGrid}" ShowPoints="{Binding ShowPoints}" Margin="8,0" AutomationProperties.Name="Real elliptic curve plot. Drag to pan, scroll to zoom. Control F to fit." />
                            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="#222B35" CornerRadius="8" Padding="18" Visibility="{Binding Snapshot.IsPlotUnavailable, Converter={StaticResource BooleanVisibility}}"><TextBlock Text="These coefficients exceed the plot's numerical precision.&#10;Your equation and invariants are still exact." TextAlignment="Center" TextWrapping="Wrap" MaxWidth="400" /></Border>
                            <!-- Place the badge inside the plot grid, beyond CurvePlot's axis-label gutter. -->
                            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="72,28,0,0" Background="#332B1E" CornerRadius="6" Padding="10,6" IsHitTestVisible="False" Visibility="{Binding Snapshot.IsSingular, Converter={StaticResource BooleanVisibility}}"><TextBlock Text="Δ = 0 · singular cubic" Foreground="{StaticResource WarningBrush}" FontSize="11" /></Border>
                        </Grid>
                        <controls:ComplexTorusView x:Name="TorusView" Grid.Row="1" Snapshot="{Binding Snapshot}" Samples="{Binding Samples}"
                                                   ShowGrid="{Binding ShowGrid}" Visibility="Collapsed" />
                        <Grid x:Name="PlotFooter" Grid.Row="2" Margin="16,0,16,12" MinHeight="32">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <WrapPanel x:Name="PlotLegend" VerticalAlignment="Center" Margin="0,0,16,0">
                                <StackPanel Orientation="Horizontal" Height="20" Margin="0,0,18,0"><Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}" Margin="0,0,7,0" /><TextBlock Text="Numerical real locus" Style="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center" /></StackPanel>
                                <StackPanel Orientation="Horizontal" Height="20"><Ellipse Width="6" Height="6" Fill="#F7CC7C" Margin="0,0,7,0" /><TextBlock Text="Exact rational samples" Style="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center" /></StackPanel>
                            </WrapPanel>
                            <WrapPanel x:Name="TorusLegend" VerticalAlignment="Center" Margin="0,0,16,0" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Height="20" Margin="0,0,18,0"><Ellipse Width="6" Height="6" Fill="{StaticResource TextBrush}" Margin="0,0,7,0" /><TextBlock Text="Selected point" Style="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center" /></StackPanel>
                                <StackPanel Orientation="Horizontal" Height="20"><Ellipse Width="6" Height="6" Fill="#F7CC7C" Margin="0,0,7,0" /><TextBlock Text="Exact rational samples" Style="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center" /></StackPanel>
                            </WrapPanel>
                            <StackPanel x:Name="PlotNavigation" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Height="30" Orientation="Horizontal">
                                <Button Content="−" Style="{StaticResource PlotNavigationButton}" Click="ZoomOutClick" ToolTip="Zoom out" AutomationProperties.Name="Zoom out" />
                                <Button Content="+" Style="{StaticResource PlotNavigationButton}" Margin="5,0" Click="ZoomInClick" ToolTip="Zoom in" AutomationProperties.Name="Zoom in" />
                                <Button x:Name="FitViewButton" Content="Reset view" Style="{StaticResource PlotNavigationButton}" Width="90" Click="FitClick" ToolTip="Reset real plot view (Ctrl+F)" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" Padding="16,10"><StackPanel><TextBlock Text="DISCRIMINANT  Δ" Style="{StaticResource Eyebrow}" /><TextBlock Text="{Binding Snapshot.Discriminant}" FontSize="20" FontFamily="Consolas" Foreground="{StaticResource TextBrush}" Margin="0,5,0,3" TextTrimming="CharacterEllipsis" ToolTip="{Binding Snapshot.Discriminant}" /><TextBlock Text="Exact rational value" Style="{StaticResource Muted}" FontSize="10" TextTrimming="CharacterEllipsis" ToolTip="Exact rational value" /></StackPanel></Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,10"><StackPanel><TextBlock Text="j-INVARIANT" Style="{StaticResource Eyebrow}" /><TextBlock Text="{Binding Snapshot.JInvariant}" FontSize="20" FontFamily="Consolas" Margin="0,5,0,3" TextTrimming="CharacterEllipsis" ToolTip="{Binding Snapshot.JInvariant}" /><TextBlock Text="Exact rational value" Style="{StaticResource Muted}" FontSize="10" TextTrimming="CharacterEllipsis" ToolTip="Exact rational value" /></StackPanel></Border>
                    <Border Grid.Column="4" Style="{StaticResource Card}" Padding="16,10"><StackPanel><TextBlock Text="REAL COMPONENTS" Style="{StaticResource Eyebrow}" /><TextBlock Text="{Binding Snapshot.Components}" FontSize="20" FontFamily="Consolas" Margin="0,5,0,3" /><TextBlock Text="{Binding Snapshot.ComponentNote}" Style="{StaticResource Muted}" FontSize="10" TextTrimming="CharacterEllipsis" ToolTip="{Binding Snapshot.ComponentNote}" /></StackPanel></Border>
                    <Border Grid.Column="6" Style="{StaticResource Card}" Padding="16,10"><StackPanel><TextBlock Text="GEOMETRY" Style="{StaticResource Eyebrow}" /><TextBlock Text="{Binding Snapshot.Status}" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,4" TextTrimming="CharacterEllipsis" ToolTip="{Binding Snapshot.Status}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource TextBrush}" /><Style.Triggers><DataTrigger Binding="{Binding Snapshot.IsSingular}" Value="True"><Setter Property="Foreground" Value="{StaticResource WarningBrush}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Text="General Weierstrass model" Style="{StaticResource Muted}" FontSize="10" TextTrimming="CharacterEllipsis" ToolTip="General Weierstrass model" /></StackPanel></Border>
                </Grid>
                <Border Grid.Row="6" Style="{StaticResource Card}" Padding="18,10">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center"><TextBlock Text="SHORT MODEL · TRANSFORMED COORDINATES" Style="{StaticResource Eyebrow}" FontSize="9" /><TextBlock Text="{Binding Snapshot.ShortEquation}" FontFamily="Cambria Math" FontSize="17" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Snapshot.ShortEquation}" /></StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="22,0"><TextBlock Text="c₄" Style="{StaticResource Muted}" /><TextBlock Text="{Binding Snapshot.C4}" FontFamily="Consolas" FontSize="13" Margin="0,5,0,0" MaxWidth="135" TextTrimming="CharacterEllipsis" ToolTip="{Binding Snapshot.C4}" /></StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="c₆" Style="{StaticResource Muted}" /><TextBlock Text="{Binding Snapshot.C6}" FontFamily="Consolas" FontSize="13" Margin="0,5,0,0" MaxWidth="135" TextTrimming="CharacterEllipsis" ToolTip="{Binding Snapshot.C6}" /></StackPanel>
                    </Grid>
                </Border>
            </Grid>
            <GridSplitter x:Name="ResultsSplitter" Grid.Column="3" Style="{StaticResource SidebarSplitter}" ToolTip="Resize results panel" AutomationProperties.Name="Resize results panel" />
            <Grid x:Name="ResultsHost" Grid.Column="4" ClipToBounds="True">
                <controls:ResultsPanel x:Name="Results" />
                <Button x:Name="ResultsTab" Style="{StaticResource SidebarTab}" Visibility="Collapsed"
                        Click="ExpandResultsClick" ToolTip="{Binding Summary}" AutomationProperties.Name="Expand results panel">
                    <StackPanel HorizontalAlignment="Center">
                        <Grid Height="24" Margin="0,0,0,10"><Path Style="{StaticResource DisclosureChevron}" Data="{StaticResource ChevronLeftGeometry}" Stroke="{StaticResource AccentBrush}" /></Grid>
                        <TextBlock Text="RESULTS" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center">
                            <TextBlock.LayoutTransform><RotateTransform Angle="-90" /></TextBlock.LayoutTransform>
                        </TextBlock>
                        <Ellipse Fill="{StaticResource AccentBrush}" Width="5" Height="5" Margin="0,12,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BooleanVisibility}}" />
                        <TextBlock Text="{Binding Jobs.Count}" FontSize="10" FontFamily="Consolas" HorizontalAlignment="Center" Margin="0,10,0,0" Visibility="{Binding HasResults, Converter={StaticResource BooleanVisibility}}" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
        <Grid Grid.Row="2" Margin="20,0">
            <TextBlock Text="{Binding InputStatus}" VerticalAlignment="Center" FontSize="10"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource MutedBrush}" /><Style.Triggers><DataTrigger Binding="{Binding HasInputError}" Value="True"><Setter Property="Foreground" Value="{StaticResource WarningBrush}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
            <TextBlock Text="{Binding SampleStatus}" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{StaticResource Muted}" FontSize="10" />
        </Grid>
    </Grid>
</Window>
