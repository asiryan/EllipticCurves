<UserControl x:Class="EllipticCurves.Explorer.Controls.ResultsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="HistoryContextMenu" TargetType="ContextMenu">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="4">
                    <ItemsPresenter />
                </Border>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="HistoryDeleteItem" TargetType="MenuItem">
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
                <Border x:Name="Frame" Background="Transparent" CornerRadius="4" Padding="12,8">
                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Frame" Property="Background" Value="{StaticResource RaisedBrush}" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.4" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>
    <Border Style="{StaticResource Card}" Padding="16">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="Results" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Clear" Click="ClearClick" IsEnabled="{Binding CanClearHistory}" Style="{StaticResource QuietButton}" Padding="4,3" Margin="8,0,4,0" Foreground="{StaticResource MutedBrush}" ToolTip="Clear all session history. Stop a running calculation first." ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Clear calculation history" />
                <Button Grid.Column="2" Content="›" HorizontalAlignment="Right" Click="HideClick" Style="{StaticResource QuietButton}" Padding="10,2" FontSize="20" ToolTip="Collapse results to the side tab" AutomationProperties.Name="Collapse results panel" />
            </Grid>
            <TextBlock Grid.Row="1" Text="{Binding Summary}" Style="{StaticResource Muted}" FontSize="11" Margin="0,7,0,14" TextWrapping="Wrap" />
            <Border Grid.Row="2" Background="#172D2B" CornerRadius="7" Padding="12" Margin="0,0,0,14" Visibility="{Binding IsBusy, Converter={StaticResource BooleanVisibility}}">
                <StackPanel>
                    <TextBlock Text="{Binding Active.Title}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <ProgressBar Height="5" Margin="0,12,0,9" Minimum="0" Maximum="100" Value="{Binding Active.ProgressValue, Mode=OneWay}" IsIndeterminate="{Binding Active.IsIndeterminate}" Foreground="{StaticResource AccentBrush}" Background="{StaticResource BorderBrush}" BorderThickness="0" AutomationProperties.Name="Calculation progress" />
                    <TextBlock Text="{Binding Active.Stage}" TextWrapping="Wrap" FontSize="11" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Active.Timing}" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <Button Grid.Column="1" Content="Stop" Command="{Binding CancelCommand}" Padding="10,5" Margin="8,0,0,0" />
                    </Grid>
                </StackPanel>
            </Border>
            <StackPanel Grid.Row="3" Margin="0,0,0,12" Visibility="{Binding HasResults, Converter={StaticResource BooleanVisibility}}">
                <TextBlock Text="SESSION HISTORY · LAST 50" Style="{StaticResource Eyebrow}" FontSize="9" Margin="0,0,0,7" />
                <ComboBox ItemsSource="{Binding Jobs}" SelectedItem="{Binding Selected}" DisplayMemberPath="HistoryLabel" AutomationProperties.Name="Calculation history" ToolTip="Right-click a history entry to delete it.">
                    <ComboBox.ItemContainerStyle><Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                        <EventSetter Event="ContextMenuOpening" Handler="HistoryContextMenuOpening" />
                        <Setter Property="ContextMenu"><Setter.Value>
                            <ContextMenu Style="{StaticResource HistoryContextMenu}">
                                <MenuItem Header="Delete" Style="{StaticResource HistoryDeleteItem}" ToolTip="Delete this result from session history. Stop a running calculation first." ToolTipService.ShowOnDisabled="True" />
                            </ContextMenu>
                        </Setter.Value></Setter>
                    </Style></ComboBox.ItemContainerStyle>
                </ComboBox>
            </StackPanel>
            <Grid Grid.Row="4">
                <StackPanel VerticalAlignment="Center" Margin="8">
                    <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding HasResults}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                    <TextBlock Text="No results yet" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="Choose a calculation in Explorer. Results and their input parameters will appear here." Style="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="20" Margin="0,10,0,0" />
                </StackPanel>
                <Grid Visibility="{Binding HasSelection, Converter={StaticResource BooleanVisibility}}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock Text="{Binding Selected.Status}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="1" Text="{Binding Selected.Timing}" Style="{StaticResource Muted}" FontSize="11" Margin="0,5,0,10" />
                    <TextBox Grid.Row="2" Text="{Binding Selected.Report, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" Style="{StaticResource ReportText}"
                             TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="{StaticResource TextBrush}" VerticalContentAlignment="Top"
                             AutomationProperties.Name="Calculation result and input parameters" ToolTip="{x:Null}" />
                </Grid>
            </Grid>
            <UniformGrid Grid.Row="5" Columns="3" Margin="0,12,0,0" IsEnabled="{Binding HasSelection}">
                <Button Content="Copy" Click="CopyClick" Padding="5,8" Margin="0,0,6,0" ToolTip="Copy the complete calculation report" />
                <Button Content="Save" Click="SaveClick" Padding="5,8" Margin="0,0,6,0" ToolTip="Save the report as text" />
                <Button Content="Repeat" Click="RepeatClick" Padding="5,8" ToolTip="Reopen this calculation with its original curve and parameters" />
            </UniformGrid>
        </Grid>
    </Border>
</UserControl>
