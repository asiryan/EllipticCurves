<UserControl x:Class="EllipticCurves.Explorer.Controls.SessionMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="SessionAction" TargetType="Button" BasedOn="{StaticResource QuietButton}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding}" />
                            <TextBlock Grid.Column="1" Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
                                       Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="24,0,0,0" />
                        </Grid>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource RaisedBrush}" /></Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <ToggleButton x:Name="Toggle" Content="File" Style="{StaticResource TitleBarMenuToggle}"
                      AutomationProperties.Name="File menu" />
        <Popup x:Name="MenuPopup" Placement="Bottom" PlacementTarget="{Binding ElementName=Toggle}"
               IsOpen="{Binding IsChecked, ElementName=Toggle, Mode=TwoWay}" StaysOpen="True"
               AllowsTransparency="True" PopupAnimation="Fade" Opened="PopupOpened">
            <Border Style="{StaticResource Card}" Width="220" Padding="8" Margin="0,6,0,0">
                <StackPanel KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Cycle">
                    <Button x:Name="NewButton" Content="New" Click="NewClick" IsEnabled="{Binding CanReplace}"
                            Tag="Ctrl+N" AutomationProperties.AcceleratorKey="Ctrl+N"
                            Style="{StaticResource SessionAction}"
                            ToolTip="Start a new session. Stop the active calculation first."
                            ToolTipService.ShowOnDisabled="True" />
                    <Button x:Name="OpenButton" Content="Open" Click="OpenClick" IsEnabled="{Binding CanReplace}"
                            Tag="Ctrl+O" AutomationProperties.AcceleratorKey="Ctrl+O"
                            Style="{StaticResource SessionAction}"
                            ToolTip="Open a session (.ec). Stop the active calculation before opening."
                            ToolTipService.ShowOnDisabled="True" />
                    <Button x:Name="SaveButton" Content="Save" Click="SaveClick"
                            Tag="Ctrl+S" AutomationProperties.AcceleratorKey="Ctrl+S"
                            Style="{StaticResource SessionAction}" IsEnabled="{Binding CanSave}"
                            ToolTip="Save changes to the current session file. Use Save as for a new session."
                            ToolTipService.ShowOnDisabled="True" />
                    <Button x:Name="SaveAsButton" Content="Save as" Click="SaveAsClick"
                            Tag="Ctrl+Shift+S" AutomationProperties.AcceleratorKey="Ctrl+Shift+S"
                            Style="{StaticResource SessionAction}" IsEnabled="{Binding CanSaveAs}"
                            ToolTip="Save this session with a different name or in another folder." />
                    <Button x:Name="ExitButton" Content="Exit" Click="ExitClick" IsEnabled="{Binding CanExit}"
                            Style="{StaticResource SessionAction}" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
