<UserControl x:Class="EllipticCurves.Explorer.Controls.EditMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="EditAction" TargetType="Button" BasedOn="{StaticResource QuietButton}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding}" />
                            <TextBlock Grid.Column="1" Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
                                       Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="24,0,0,0" />
                        </Grid>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource RaisedBrush}" /></Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <ToggleButton x:Name="Toggle" Content="Edit" Style="{StaticResource TitleBarMenuToggle}" AutomationProperties.Name="Edit menu" />
        <Popup x:Name="MenuPopup" Placement="Bottom" PlacementTarget="{Binding ElementName=Toggle}"
               IsOpen="{Binding IsChecked, ElementName=Toggle, Mode=TwoWay}" StaysOpen="True"
               AllowsTransparency="True" PopupAnimation="Fade" Opened="PopupOpened">
            <Border Style="{StaticResource Card}" Width="220" Padding="8" Margin="0,6,0,0">
                <StackPanel KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Cycle">
                    <Button x:Name="UndoButton" Content="Undo" Tag="Ctrl + Z" AutomationProperties.AcceleratorKey="Ctrl+Z"
                            Style="{StaticResource EditAction}" Click="UndoClick" IsEnabled="{Binding CanUndo}"
                            ToolTip="Undo the last edit. Available after the active calculation finishes." ToolTipService.ShowOnDisabled="True" />
                    <Button x:Name="RedoButton" Content="Redo" Tag="Ctrl + Y" AutomationProperties.AcceleratorKey="Ctrl+Y"
                            Style="{StaticResource EditAction}" Click="RedoClick" IsEnabled="{Binding CanRedo}"
                            ToolTip="Restore the next saved state without running calculations again." ToolTipService.ShowOnDisabled="True" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
