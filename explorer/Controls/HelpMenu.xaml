<UserControl x:Class="EllipticCurves.Explorer.Controls.HelpMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="HelpAction" TargetType="Button" BasedOn="{StaticResource QuietButton}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="ContentTemplate"><Setter.Value><DataTemplate>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding}" />
                    <TextBlock Grid.Column="1" Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
                               Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="24,0,0,0" />
                </Grid>
            </DataTemplate></Setter.Value></Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource RaisedBrush}" /></Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <ToggleButton x:Name="Toggle" Content="Help" Style="{StaticResource TitleBarMenuToggle}" AutomationProperties.Name="Help menu" />
        <Popup x:Name="MenuPopup" Placement="Bottom" PlacementTarget="{Binding ElementName=Toggle}"
               IsOpen="{Binding IsChecked, ElementName=Toggle, Mode=TwoWay}" StaysOpen="True"
               AllowsTransparency="True" PopupAnimation="Fade" Opened="PopupOpened">
            <Border Style="{StaticResource Card}" Width="270" Padding="8" Margin="0,6,0,0">
                <StackPanel KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Cycle">
                    <Button x:Name="GuideButton" Content="User Guide" Tag="F1" Style="{StaticResource HelpAction}" Click="GuideClick"
                            AutomationProperties.AcceleratorKey="F1" ToolTip="Open the user guide in your browser." />
                    <Button Content="Keyboard Shortcuts" Style="{StaticResource HelpAction}" Click="ShortcutsClick" />
                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="12,6" />
                    <Button Content="LMFDB Website" Tag="↗" Style="{StaticResource HelpAction}" Click="LmfdbClick" ToolTip="Open LMFDB in your browser." />
                    <Button Content="Project on GitHub" Tag="↗" Style="{StaticResource HelpAction}" Click="ProjectClick" ToolTip="Open the project repository in your browser." />
                    <Button Content="Report an Issue" Tag="↗" Style="{StaticResource HelpAction}" Click="IssueClick" ToolTip="Open a new GitHub issue in your browser." />
                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="12,6" />
                    <Button Content="About EllipticCurves" Style="{StaticResource HelpAction}" Click="AboutClick" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
