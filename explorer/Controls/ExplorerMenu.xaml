<UserControl x:Class="EllipticCurves.Explorer.Controls.ExplorerMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <ToggleButton x:Name="Toggle" Content="Explorer" Style="{StaticResource TitleBarMenuToggle}" AutomationProperties.Name="Explorer calculations menu" />
        <!-- Outside clicks are handled by the owner window so automatic dismissal
             cannot uncheck Toggle before its own closing click reaches it. -->
        <Popup x:Name="MenuPopup" Placement="Bottom" PlacementTarget="{Binding ElementName=Toggle}"
               IsOpen="{Binding IsChecked, ElementName=Toggle, Mode=TwoWay}" StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade" Opened="PopupOpened">
            <Border Style="{StaticResource Card}" Width="680" Padding="16" Margin="0,6,0,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid><TextBlock Text="CALCULATE &amp; EXPLORE" Style="{StaticResource Eyebrow}" /><TextBlock Text="Search calculations below" Style="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Right" /></Grid>
                    <TextBox x:Name="SearchBox" Grid.Row="1" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,12,0,12" MinHeight="36" FontFamily="Segoe UI" FontSize="13"
                             AutomationProperties.Name="Search calculations" ToolTip="Search by name, topic or description" />
                    <Grid Grid.Row="2" Height="390">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="205" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <ListBox ItemsSource="{Binding Groups}" SelectedItem="{Binding Group}" Style="{StaticResource WorkbenchList}"
                                 AutomationProperties.Name="Calculation categories">
                            <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" /></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                        <ListBox x:Name="OperationsList" Grid.Column="2" ItemsSource="{Binding Operations}" Style="{StaticResource WorkbenchList}"
                                 PreviewMouseDown="OperationMouseDown"
                                 AutomationProperties.Name="Available calculations" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate><DataTemplate>
                                <Button Click="OperationClick" Tag="{Binding}" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Stretch" Padding="8,8"
                                        ToolTip="{Binding Description}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontSize="13" />
                                        <TextBlock Text="{Binding Group}" Style="{StaticResource Muted}" FontSize="10" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                    <TextBlock Grid.Row="3" Text="{Binding Summary}" Style="{StaticResource Muted}" FontSize="11" Margin="0,12,0,0" />
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
